  "panels": [
    {"id":100,"type":"row","title":"1. 연결 주인 — 은행에 붙은 게이트웨이는 하나인가","collapsed":false,"gridPos":{"x":0,"y":0,"w":24,"h":1},"panels":[]},
    {"id":1,"type":"timeseries","title":"리더 수 합 (정상 = 1)","description":"답하는 질문: 은행 연결 주인이 정확히 하나인가? 선 = 1(정상) · 2(겹침)","gridPos":{"x":0,"y":1,"w":6,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"fieldConfig":{"defaults":{"unit":"short","custom":{"thresholdsStyle":{"mode":"line"}},"thresholds":{"mode":"absolute","steps":[{"color":"red","value":null},{"color":"green","value":1},{"color":"red","value":2}]}},"overrides":[]},"targets":[{"refId":"A","expr":"sum(banktransfer_gateway_leader) or vector(0)","legendFormat":"리더 수"}]},
    {"id":2,"type":"timeseries","title":"Pod 별 리더 (계단)","description":"답하는 질문: 누가 언제 리더였나? (교대 순간)","gridPos":{"x":6,"y":1,"w":6,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"fieldConfig":{"defaults":{"unit":"short","custom":{"lineInterpolation":"stepAfter"}},"overrides":[]},"targets":[{"refId":"A","expr":"banktransfer_gateway_leader","legendFormat":"{{pod}} @ {{node}}"}]},
    {"id":3,"type":"timeseries","title":"Pod 별 은행 연결 (0 = 은행 공백)","description":"답하는 질문: 은행 회선이 끊긴 구간은? (모두 0 인 구간 = 은행 공백, 실험 M1 의 숫자)","gridPos":{"x":12,"y":1,"w":8,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"fieldConfig":{"defaults":{"unit":"short","custom":{"lineInterpolation":"stepAfter"}},"overrides":[]},"targets":[{"refId":"A","expr":"banktransfer_gateway_bank_connected","legendFormat":"{{pod}} @ {{node}}"}]},
    {"id":4,"type":"stat","title":"리더 임기 (15분)","description":"답하는 질문: 교대가 잦은가? (평소 0)","gridPos":{"x":20,"y":1,"w":4,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"fieldConfig":{"defaults":{"unit":"short","thresholds":{"mode":"absolute","steps":[{"color":"green","value":null},{"color":"orange","value":2}]}},"overrides":[]},"options":{"colorMode":"background","graphMode":"none","reduceOptions":{"calcs":["lastNotNull"],"fields":"","values":false}},"targets":[{"refId":"A","expr":"sum(increase(banktransfer_gateway_leader_terms_total[15m]))","legendFormat":"임기"}]},
    {"id":101,"type":"row","title":"2. 은행 호출 — 느린가 · 거절하나 · 안 보내나","collapsed":false,"gridPos":{"x":0,"y":9,"w":24,"h":1},"panels":[]},
    {"id":5,"type":"timeseries","title":"은행 호출 지연 p50 · p95 (종류별)","description":"답하는 질문: 은행이 느려졌나? (응답 시간 초과 3초)","gridPos":{"x":0,"y":10,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"fieldConfig":{"defaults":{"unit":"s"},"overrides":[]},"targets":[{"refId":"A","expr":"histogram_quantile(0.5, sum by (le, type) (rate(banktransfer_gateway_bank_request_seconds_bucket{outcome=~\"ok|rejected\"}[1m])))","legendFormat":"p50 {{type}}"},{"refId":"B","expr":"histogram_quantile(0.95, sum by (le, type) (rate(banktransfer_gateway_bank_request_seconds_bucket{outcome=~\"ok|rejected\"}[1m])))","legendFormat":"p95 {{type}}"}]},
    {"id":6,"type":"timeseries","title":"은행 호출 결과 /초","description":"답하는 질문: 거절 · 안 보냄 · 모름이 늘었나?","gridPos":{"x":12,"y":10,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"fieldConfig":{"defaults":{"unit":"reqps"},"overrides":[]},"targets":[{"refId":"A","expr":"sum by (outcome) (rate(banktransfer_gateway_bank_request_seconds_count[1m]))","legendFormat":"{{outcome}}"}]},
    {"id":7,"type":"timeseries","title":"안 보냄 사유 /초","description":"답하는 질문: 왜 안 보냈나? not_leader · disconnected · no_tran_no · maintenance …","gridPos":{"x":0,"y":18,"w":8,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"fieldConfig":{"defaults":{"unit":"reqps"},"overrides":[]},"targets":[{"refId":"A","expr":"sum by (reason) (rate(banktransfer_gateway_not_sent_total[1m]))","legendFormat":"{{reason}}"}]},
    {"id":8,"type":"timeseries","title":"전문번호 남은 수 (Pod 별)","description":"답하는 질문: 번호 구간이 바닥나나? 자정(KST) 뒤에는 첫 요청 전까지 0 으로 보인다 (다음 구간은 그때 예약 — 지연 예약)","gridPos":{"x":8,"y":18,"w":8,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"fieldConfig":{"defaults":{"unit":"short"},"overrides":[]},"targets":[{"refId":"A","expr":"banktransfer_gateway_tran_no_remaining","legendFormat":"{{pod}} @ {{node}}"}]},
    {"id":17,"type":"timeseries","title":"전문번호 예약 결과 (5분 증가)","description":"답하는 질문: 번호 구간 예약이 충돌 · 실패하나? 예약 시도 수 = ok + error (끝내 실패한 예약은 conflict 가 여러 번 + error 1번)","gridPos":{"x":16,"y":18,"w":8,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"fieldConfig":{"defaults":{"unit":"short"},"overrides":[]},"targets":[{"refId":"A","expr":"sum by (result) (increase(banktransfer_gateway_tran_no_reserve_total[5m]))","legendFormat":"{{result}}"}]},
    {"id":102,"type":"row","title":"3. JVM · 자원 (api · 게이트웨이, Pod 별)","collapsed":false,"gridPos":{"x":0,"y":26,"w":24,"h":1},"panels":[]},
    {"id":9,"type":"timeseries","title":"힙 사용","description":"답하는 질문: 메모리가 차오르나? (limit: api 768Mi · 게이트웨이 512Mi)","gridPos":{"x":0,"y":27,"w":8,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"fieldConfig":{"defaults":{"unit":"bytes"},"overrides":[]},"targets":[{"refId":"A","expr":"sum by (pod, node) (jvm_memory_used_bytes{namespace=\"bank-transfer\", area=\"heap\"})","legendFormat":"{{pod}} @ {{node}}"}]},
    {"id":10,"type":"timeseries","title":"GC 멈춤 (초/초)","description":"답하는 질문: GC 가 요청을 멈추게 하나?","gridPos":{"x":8,"y":27,"w":8,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"fieldConfig":{"defaults":{"unit":"s"},"overrides":[]},"targets":[{"refId":"A","expr":"sum by (pod, node) (rate(jvm_gc_pause_seconds_sum{namespace=\"bank-transfer\"}[1m]))","legendFormat":"{{pod}} @ {{node}}"}]},
    {"id":11,"type":"timeseries","title":"스레드","description":"답하는 질문: 스레드가 늘어 쌓이나?","gridPos":{"x":16,"y":27,"w":8,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"fieldConfig":{"defaults":{"unit":"short"},"overrides":[]},"targets":[{"refId":"A","expr":"sum by (pod, node) (jvm_threads_live_threads{namespace=\"bank-transfer\"})","legendFormat":"{{pod}} @ {{node}}"}]},
    {"id":12,"type":"timeseries","title":"Hikari 활성 · 대기 (api)","description":"답하는 질문: DB 커넥션이 모자라나? (풀 20)","gridPos":{"x":0,"y":35,"w":8,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"fieldConfig":{"defaults":{"unit":"short"},"overrides":[]},"targets":[{"refId":"A","expr":"sum by (pod, node) (hikaricp_connections_active{app=\"api\"})","legendFormat":"활성 {{pod}} @ {{node}}"},{"refId":"B","expr":"sum by (pod, node) (hikaricp_connections_pending{app=\"api\"})","legendFormat":"대기 {{pod}} @ {{node}}"}]},
    {"id":13,"type":"timeseries","title":"Hikari 커넥션 대기 시간 (api, 평균)","description":"답하는 질문: 커넥션을 얻으려고 얼마나 기다리나?","gridPos":{"x":8,"y":35,"w":8,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"fieldConfig":{"defaults":{"unit":"s"},"overrides":[]},"targets":[{"refId":"A","expr":"sum by (pod, node) (rate(hikaricp_connections_acquire_seconds_sum{app=\"api\"}[1m])) / sum by (pod, node) (rate(hikaricp_connections_acquire_seconds_count{app=\"api\"}[1m]))","legendFormat":"{{pod}} @ {{node}}"}]},
    {"id":14,"type":"timeseries","title":"Tomcat 바쁜 스레드 (api)","description":"답하는 질문: 요청 스레드가 다 찼나? (최대 200)","gridPos":{"x":16,"y":35,"w":8,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"fieldConfig":{"defaults":{"unit":"short"},"overrides":[]},"targets":[{"refId":"A","expr":"sum by (pod, node) (tomcat_threads_busy_threads{app=\"api\"})","legendFormat":"{{pod}} @ {{node}}"}]},
    {"id":15,"type":"timeseries","title":"상태 지표 조회 시간 (선 = 50ms)","description":"답하는 질문: 상태 Gauge 의 DB 조회가 무거워졌나? 50ms 를 넘으면 V7 (status, updated_at) 인덱스 — 위험 B1","gridPos":{"x":0,"y":43,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"fieldConfig":{"defaults":{"unit":"s","custom":{"thresholdsStyle":{"mode":"line"}},"thresholds":{"mode":"absolute","steps":[{"color":"transparent","value":null},{"color":"red","value":0.05}]}},"overrides":[]},"targets":[{"refId":"A","expr":"max(banktransfer_metrics_db_query_seconds_max)","legendFormat":"max"},{"refId":"B","expr":"sum(rate(banktransfer_metrics_db_query_seconds_sum[1m])) / sum(rate(banktransfer_metrics_db_query_seconds_count[1m]))","legendFormat":"평균"}]},
    {"id":16,"type":"timeseries","title":"상태 지표 조회 실패 /초","description":"답하는 질문: 상태 Gauge 가 NaN 인 이유가 DB 인가? (MetricsMissing 알림)","gridPos":{"x":12,"y":43,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"fieldConfig":{"defaults":{"unit":"reqps"},"overrides":[]},"targets":[{"refId":"A","expr":"sum(rate(banktransfer_metrics_db_query_seconds_count{result=\"error\"}[1m]))","legendFormat":"error"}]}
  ]
