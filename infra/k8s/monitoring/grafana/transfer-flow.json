{
  "uid": "bt-transfer-flow",
  "title": "bank-transfer ① 출금 흐름",
  "description": "P9a — 위에서부터 읽으면 막힌 단계가 좁혀진다 (OPERATION §17-2). 카운터는 근사치, 돈의 정답은 DB · P9c 4행 = 로그 (Loki)",
  "tags": ["bank-transfer", "p9a", "p9c"],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {"from": "now-15m", "to": "now"},
  "templating": {"list": []},
  "annotations": {"list": []},
  "panels": [
    {"id":100,"type":"row","title":"1. 한눈에 — 돈이 흐르고 있나","collapsed":false,"gridPos":{"x":0,"y":0,"w":24,"h":1},"panels":[]},
    {"id":1,"type":"timeseries","title":"접수 · 완료 · 실패 /초","description":"답하는 질문: 접수한 만큼 완료가 따라오나? (완료 · 실패 = 접수 → 확정 Timer 건수)","gridPos":{"x":0,"y":1,"w":8,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"fieldConfig":{"defaults":{"unit":"reqps"},"overrides":[]},"targets":[{"refId":"A","expr":"sum(rate(banktransfer_transfer_accepted_total{result=\"created\"}[1m]))","legendFormat":"접수"},{"refId":"B","expr":"sum(rate(banktransfer_transfer_completed_seconds_count{status=\"COMPLETED\"}[1m]))","legendFormat":"완료"},{"refId":"C","expr":"sum(rate(banktransfer_transfer_completed_seconds_count{status=\"FAILED\"}[1m]))","legendFormat":"실패"}]},
    {"id":2,"type":"timeseries","title":"미완료 건 (상태별)","description":"답하는 질문: 끝나지 않고 쌓이는 출금이 있나? (DB 10초 조회 · api 2대 중 max)","gridPos":{"x":8,"y":1,"w":8,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"fieldConfig":{"defaults":{"unit":"short"},"overrides":[]},"targets":[{"refId":"A","expr":"max by (status) (banktransfer_transfer_open)","legendFormat":"{{status}}"}]},
    {"id":3,"type":"timeseries","title":"가장 오래된 미완료 나이 (상태별)","description":"답하는 질문: 얼마나 오래 막혀 있나? 선 = 알림 임계 (SENDING 120초 · RECEIVED 900초 (마지막 변화 뒤))","gridPos":{"x":16,"y":1,"w":8,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"fieldConfig":{"defaults":{"unit":"s","custom":{"thresholdsStyle":{"mode":"line"}},"thresholds":{"mode":"absolute","steps":[{"color":"transparent","value":null},{"color":"orange","value":120},{"color":"red","value":900}]}},"overrides":[]},"targets":[{"refId":"A","expr":"max by (status) (banktransfer_transfer_open_oldest_seconds)","legendFormat":"{{status}}"}]},
    {"id":4,"type":"stat","title":"결과조회 소진 UNKNOWN","description":"답하는 질문: 일마감 대사가 맞춰야 할 출금이 있나? (0 이 정상)","gridPos":{"x":0,"y":9,"w":6,"h":4},"datasource":{"type":"prometheus","uid":"prometheus"},"fieldConfig":{"defaults":{"unit":"short","thresholds":{"mode":"absolute","steps":[{"color":"green","value":null},{"color":"red","value":1}]}},"overrides":[]},"options":{"colorMode":"background","graphMode":"none","reduceOptions":{"calcs":["lastNotNull"],"fields":"","values":false}},"targets":[{"refId":"A","expr":"max(banktransfer_transfer_unknown_exhausted)","legendFormat":"소진"}]},
    {"id":5,"type":"stat","title":"은행 점검 중","description":"답하는 질문: 지금 점검 시간인가? (점검 중 · 끝난 뒤 30분은 일부 알림이 빠진다)","gridPos":{"x":6,"y":9,"w":6,"h":4},"datasource":{"type":"prometheus","uid":"prometheus"},"fieldConfig":{"defaults":{"mappings":[{"type":"value","options":{"0":{"text":"아님","color":"green"},"1":{"text":"점검 중","color":"orange"}}}],"thresholds":{"mode":"absolute","steps":[{"color":"green","value":null}]}},"overrides":[]},"options":{"colorMode":"background","graphMode":"none","reduceOptions":{"calcs":["lastNotNull"],"fields":"","values":false}},"targets":[{"refId":"A","expr":"max(banktransfer_bank_maintenance)","legendFormat":"점검"}]},
    {"id":6,"type":"stat","title":"울리는 알림","description":"답하는 질문: 지금 사람이 봐야 할 것이 있나? (자세히는 Alertmanager — OPERATION §17-3)","gridPos":{"x":12,"y":9,"w":12,"h":4},"datasource":{"type":"prometheus","uid":"prometheus"},"fieldConfig":{"defaults":{"unit":"short","thresholds":{"mode":"absolute","steps":[{"color":"green","value":null},{"color":"red","value":1}]}},"overrides":[]},"options":{"colorMode":"background","graphMode":"none","reduceOptions":{"calcs":["lastNotNull"],"fields":"","values":false}},"targets":[{"refId":"A","expr":"count(ALERTS{alertstate=\"firing\"}) or vector(0)","legendFormat":"firing"}]},
    {"id":101,"type":"row","title":"2. 단계별 — 아웃박스 → Kafka → 은행 → 정리","collapsed":false,"gridPos":{"x":0,"y":13,"w":24,"h":1},"panels":[]},
    {"id":7,"type":"timeseries","title":"아웃박스 미발행 건","description":"답하는 질문: 접수는 됐는데 Kafka 로 못 나간 것이 쌓이나?","gridPos":{"x":0,"y":14,"w":8,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"fieldConfig":{"defaults":{"unit":"short"},"overrides":[]},"targets":[{"refId":"A","expr":"max(banktransfer_outbox_unpublished)","legendFormat":"미발행"}]},
    {"id":8,"type":"timeseries","title":"아웃박스 가장 오래된 나이","description":"답하는 질문: 발행기가 멈췄나? 선 = 알림 임계 60초 (발행 주기 0.5초)","gridPos":{"x":8,"y":14,"w":8,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"fieldConfig":{"defaults":{"unit":"s","custom":{"thresholdsStyle":{"mode":"line"}},"thresholds":{"mode":"absolute","steps":[{"color":"transparent","value":null},{"color":"red","value":60}]}},"overrides":[]},"targets":[{"refId":"A","expr":"max(banktransfer_outbox_unpublished_oldest_seconds)","legendFormat":"나이"}]},
    {"id":9,"type":"timeseries","title":"Kafka 컨슈머 lag (최대, Pod 별)","description":"답하는 질문: 컨슈머가 따라가고 있나?","gridPos":{"x":16,"y":14,"w":8,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"fieldConfig":{"defaults":{"unit":"short"},"overrides":[]},"targets":[{"refId":"A","expr":"max by (pod, node) (kafka_consumer_fetch_manager_records_lag_max{app=\"api\"})","legendFormat":"{{pod}} @ {{node}}"}]},
    {"id":10,"type":"timeseries","title":"은행 결과 /초 (컨슈머)","description":"답하는 질문: 은행이 받아 주나? not_sent = 안 보냄(재시도), unknown = 모름(결과조회), maintenance = 점검 보류","gridPos":{"x":0,"y":22,"w":8,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"fieldConfig":{"defaults":{"unit":"reqps"},"overrides":[]},"targets":[{"refId":"A","expr":"sum by (outcome) (rate(banktransfer_transfer_bank_result_total[1m]))","legendFormat":"{{outcome}}"}]},
    {"id":11,"type":"timeseries","title":"DLT · 재발행 · 결과조회 · 포기 (5분 증가)","description":"답하는 질문: 정리 경로가 일하고 있나? DLT other · 포기 E001 은 사람이 볼 것","gridPos":{"x":8,"y":22,"w":8,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"fieldConfig":{"defaults":{"unit":"short"},"overrides":[]},"targets":[{"refId":"A","expr":"sum by (kind) (increase(banktransfer_transfer_dlt_total[5m]))","legendFormat":"DLT {{kind}}"},{"refId":"B","expr":"sum(increase(banktransfer_transfer_republished_total[5m]))","legendFormat":"재발행"},{"refId":"C","expr":"sum by (result) (increase(banktransfer_transfer_reconciled_total[5m]))","legendFormat":"결과조회 {{result}}"},{"refId":"D","expr":"sum(increase(banktransfer_transfer_gave_up_total[5m]))","legendFormat":"포기 E001"}]},
    {"id":12,"type":"timeseries","title":"아웃박스 발행 /초","description":"답하는 질문: 발행기가 돌고 있나? error = 실패한 주기","gridPos":{"x":16,"y":22,"w":8,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"fieldConfig":{"defaults":{"unit":"reqps"},"overrides":[]},"targets":[{"refId":"A","expr":"sum by (result) (rate(banktransfer_outbox_published_total[1m]))","legendFormat":"{{result}}"}]},
    {"id":102,"type":"row","title":"3. 체감 — 사용자가 느끼는 시간","collapsed":false,"gridPos":{"x":0,"y":30,"w":24,"h":1},"panels":[]},
    {"id":13,"type":"timeseries","title":"접수 → 확정 시간 p50 · p95 · p99","description":"답하는 질문: 출금 하나가 끝나기까지 얼마나 걸리나? (재시도 · 결과조회를 거치면 분 단위)","gridPos":{"x":0,"y":31,"w":8,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"fieldConfig":{"defaults":{"unit":"s"},"overrides":[]},"targets":[{"refId":"A","expr":"histogram_quantile(0.5, sum by (le) (rate(banktransfer_transfer_completed_seconds_bucket{status=\"COMPLETED\"}[5m])))","legendFormat":"p50","exemplar":true},{"refId":"B","expr":"histogram_quantile(0.95, sum by (le) (rate(banktransfer_transfer_completed_seconds_bucket{status=\"COMPLETED\"}[5m])))","legendFormat":"p95","exemplar":true},{"refId":"C","expr":"histogram_quantile(0.99, sum by (le) (rate(banktransfer_transfer_completed_seconds_bucket{status=\"COMPLETED\"}[5m])))","legendFormat":"p99","exemplar":true}]},
    {"id":14,"type":"timeseries","title":"HTTP p95 (경로별)","description":"답하는 질문: API 가 느려졌나?","gridPos":{"x":8,"y":31,"w":8,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"fieldConfig":{"defaults":{"unit":"s"},"overrides":[]},"targets":[{"refId":"A","expr":"histogram_quantile(0.95, sum by (le, uri) (rate(http_server_requests_seconds_bucket{app=\"api\", uri!~\"/actuator.*\"}[1m])))","legendFormat":"{{uri}}"}]},
    {"id":15,"type":"timeseries","title":"HTTP 5xx 비율 (경로별)","description":"답하는 질문: 사용자가 오류를 보나? 선 = 알림 임계 5% (알림은 점검 중 · 끝난 뒤 30분을 빼지만 이 그래프는 빼지 않는다)","gridPos":{"x":16,"y":31,"w":8,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"fieldConfig":{"defaults":{"unit":"percentunit","custom":{"thresholdsStyle":{"mode":"line"}},"thresholds":{"mode":"absolute","steps":[{"color":"transparent","value":null},{"color":"red","value":0.05}]}},"overrides":[]},"targets":[{"refId":"A","expr":"sum by (uri) (rate(http_server_requests_seconds_count{app=\"api\", status=~\"5..\", uri!~\"/actuator.*\"}[1m])) / sum by (uri) (rate(http_server_requests_seconds_count{app=\"api\", uri!~\"/actuator.*\"}[1m]))","legendFormat":"{{uri}}"}]},
    {"id":103,"type":"row","title":"4. 로그 — 같은 시각에 무슨 일이 찍혔나 (P9c, Loki)","collapsed":false,"gridPos":{"x":0,"y":39,"w":24,"h":1},"panels":[]},
    {"id":16,"type":"timeseries","title":"로그 양 /분 (서비스 · 레벨)","description":"답하는 질문: 어느 서비스가 갑자기 많이 쓰나? ERROR 가 늘었나? (level 은 구조화 메타데이터 — Redis 처럼 수준이 없는 줄은 빈 값)","gridPos":{"x":0,"y":40,"w":8,"h":8},"datasource":{"type":"loki","uid":"loki"},"fieldConfig":{"defaults":{"unit":"short","custom":{"drawStyle":"bars","fillOpacity":60,"stacking":{"mode":"normal"}}},"overrides":[]},"targets":[{"refId":"A","expr":"sum by (app, level) (count_over_time({namespace=\"bank-transfer\"} [1m]))","legendFormat":"{{app}} {{level}}","queryType":"range"}]},
    {"id":17,"type":"logs","title":"api · 게이트웨이 ERROR · WARN 로그","description":"답하는 질문: 지표가 꺾인 시각에 무슨 오류가 찍혔나? 줄을 펼치면 trace_id → Tempo (OPERATION §19-3). 계좌 · 금액은 수집 때 가려져 있다","gridPos":{"x":8,"y":40,"w":16,"h":8},"datasource":{"type":"loki","uid":"loki"},"options":{"showTime":true,"wrapLogMessage":true,"sortOrder":"Descending","enableLogDetails":true},"targets":[{"refId":"A","expr":"{namespace=\"bank-transfer\", app=~\"api|bank-gateway\"} | level=~\"ERROR|WARN\"","queryType":"range"}]}
  ]
