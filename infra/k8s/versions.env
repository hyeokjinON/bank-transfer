# P8-3a 버전 · 이름 고정 한 곳 (스크립트 · CI 가 source 한다). 2026-11-12 확인, 모두 2주 이상 지난 안정 릴리스.
# 올릴 때는 Envoy Gateway 호환표(https://gateway.envoyproxy.io/news/releases/matrix/)의 K8s 범위를 먼저 본다 — v1.9 는 1.33 ~ 1.36
KIND_VERSION=v0.33.0
# kind v0.33.0 의 기본(1.37)이 아니라 같은 릴리스의 1.36 — Envoy Gateway v1.9 시험 범위 안
KIND_NODE_IMAGE=kindest/node:v1.36.4@sha256:099e049362a1526b2db71494e1947aae99bd16290d7c895f2b7ea312e3cbfaed
KUBECTL_VERSION=v1.36.4
# install.yaml 이 Gateway API v1.6.1 CRD 를 같이 넣는다 (따로 설치하지 않는다)
ENVOY_GATEWAY_VERSION=v1.9.3
CURL_IMAGE=curlimages/curl:8.23.0
K6_IMAGE=grafana/k6:2.3.0
# P9a 관측 (2026-11-17 확인 — 모두 2주 이상 지난 안정판). 매니페스트는 태그 없는 이름, apply_overlay 가 이 값으로 덮는다.
# promtool · amtool 도 같은 이미지 안의 것을 쓴다 (infra/k8s/monitoring/check.sh). 올리기 전: docker manifest inspect <이미지:태그>
PROMETHEUS_VERSION=v3.5.0
ALERTMANAGER_VERSION=v0.28.1
GRAFANA_VERSION=12.0.0
BUSYBOX_VERSION=1.37.0
# P9b 추적 (2026-11-18 확인 — 2026-10-21 공개, 2.x 마지막 줄 패치. 3.x 는 구성이 크게 바뀌어 이 단계에서 쓰지 않는다). 올리기 전: docker manifest inspect grafana/tempo:<태그>
TEMPO_VERSION=2.10.10
# P9c 로그 (2026-11-19 확인 — 둘 다 2주 이상 지난 안정판. Loki 4.0 은 rc, Alloy v1.22.0 은 11-13 로 새것). 올리기 전: docker manifest inspect <이미지:태그>
# Loki 3.7.9 빌드 2026-10-20 (amd64 압축 45MiB), Alloy v1.21.3 2026-10-28 (amd64 압축 213MiB — DaemonSet 이라 노드 3대가 각자 받는다).
# check.sh 도 이 이미지 안의 loki(-verify-config) · alloy(fmt · run) 를 쓴다
LOKI_VERSION=3.7.9
ALLOY_VERSION=v1.21.3
CLUSTER_NAME=bank-transfer
NAMESPACE=bank-transfer
