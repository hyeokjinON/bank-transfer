# P8-3a 버전 · 이름 고정 한 곳 (스크립트 · CI 가 source 한다). 2026-11-12 확인, 모두 2주 이상 지난 안정 릴리스.
# 올릴 때는 Envoy Gateway 호환표(https://gateway.envoyproxy.io/news/releases/matrix/)의 K8s 범위를 먼저 본다 — v1.9 는 1.33 ~ 1.36
KIND_VERSION=v0.33.0
# kind v0.33.0 의 기본(1.37)이 아니라 같은 릴리스의 1.36 — Envoy Gateway v1.9 시험 범위 안
KIND_NODE_IMAGE=kindest/node:v1.36.4@sha256:099e049362a1526b2db71494e1947aae99bd16290d7c895f2b7ea312e3cbfaed
KUBECTL_VERSION=v1.36.4
# install.yaml 이 Gateway API v1.6.1 CRD 를 같이 넣는다 (따로 설치하지 않는다)
ENVOY_GATEWAY_VERSION=v1.9.3
CURL_IMAGE=curlimages/curl:8.23.0
K6_IMAGE=grafana/k6:2.3.0
CLUSTER_NAME=bank-transfer
NAMESPACE=bank-transfer
