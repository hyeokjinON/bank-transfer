# 복사해서 사용: cp infra/.env.example infra/.env  (infra/.env 는 git 에 올리지 않는다)
# 로컬 개발용 값이다. 운영 비밀번호를 여기에 쓰지 말 것.
MYSQL_DATABASE=bank_transfer
MYSQL_USER=bank
MYSQL_PASSWORD=local-dev-only
MYSQL_ROOT_PASSWORD=local-root-only

# 포트가 이미 쓰이고 있으면 바꾼다 (예: PC 에 MySQL 이 설치돼 있으면 MYSQL_PORT=3307)
MYSQL_PORT=3306
KAFKA_PORT=9092
REDIS_PORT=6379

# KRaft 클러스터 ID (base64 UUID 22자). 바꾸면 기존 kafka-data 볼륨과 맞지 않으니 down -v 후 사용
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
